[Unit]
Description=Ly Route isolated management DHCP
Requires=ly-route-firstboot.service
After=ly-route-firstboot.service systemd-networkd.service

[Service]
User=_kea
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW
Environment=KEA_LOCKFILE_DIR=/run/lock/kea
Environment=KEA_PIDFILE_DIR=/run/kea-management
RuntimeDirectory=kea-management lock/kea
RuntimeDirectoryPreserve=yes
StateDirectory=kea
ExecStartPre=/usr/sbin/kea-dhcp4 -t /etc/kea/kea-dhcp4-management.conf
ExecStart=/usr/sbin/kea-dhcp4 -c /etc/kea/kea-dhcp4-management.conf
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target

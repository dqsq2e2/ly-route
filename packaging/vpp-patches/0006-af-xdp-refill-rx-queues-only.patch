diff --git a/src/plugins/af_xdp/input.c b/src/plugins/af_xdp/input.c
--- a/src/plugins/af_xdp/input.c
+++ b/src/plugins/af_xdp/input.c
@@ -351,8 +351,11 @@
 af_xdp_device_input_refill (af_xdp_device_t *ad)
 {
   vlib_main_t *vm = vlib_get_main ();
-  af_xdp_rxq_t *rxq;
-  vec_foreach (rxq, ad->rxqs)
-    af_xdp_device_input_refill_inline (vm, 0, ad, rxq);
+  u32 qid;
+  /* The vector also contains fill rings for TX-only UMEMs. Their RX

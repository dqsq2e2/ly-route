+  for (qid = 0; qid < ad->rxq_num; qid++)
+    af_xdp_device_input_refill_inline (vm, 0, ad,
+                                      vec_elt_at_index (ad->rxqs, qid));
 }
 #endif /* CLIB_MARCH_VARIANT */
